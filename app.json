{
  "expo": {
    "name": "lumio",
    "slug": "lumio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "O Lumio converte sua fala em texto para preencher as respostas do onboarding.",
        "NSMicrophoneUsageDescription": "O Lumio usa o microfone para você poder responder ao onboarding por voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.zluhcastro.lumio"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "newArchEnabled": true,
    "scheme": "lumio",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Lumio precisa acessar suas fotos para usar uma imagem de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Lumio usa o microfone para você poder responder ao onboarding por voz.",
          "speechRecognitionPermission": "O Lumio converte sua fala em texto para preencher as respostas do onboarding."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "283de31d-2012-4e22-b258-dd25f8842fd8"
      }
    }
  }
}
