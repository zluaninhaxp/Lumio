{
  "name": "lumio",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "deno check supabase/functions/ai/index.ts supabase/functions/delete-account/index.ts",
    "test:surfaces": "node scripts/card-surfaces.test.cjs",
    "test:task-suggestions": "node scripts/task-suggestions.test.cjs",
    "test:voice": "node scripts/voice-recognition.test.cjs",
    "test:visual-stage3": "node scripts/visual-stage3.test.cjs",
    "test:bottom-sheet": "node scripts/bottom-sheet-layout.test.cjs && node scripts/bottom-sheet-dismissal.test.cjs",
    "test:modal-focus": "node scripts/modal-focus.test.cjs",
    "test:system-bars": "node scripts/system-bars.test.cjs",
    "test:onboarding": "node scripts/onboarding-flow.test.cjs",
    "test:alerts": "node scripts/app-alert.test.cjs",
    "test:ai": "node scripts/ai-architecture.test.cjs",
    "test:ai:remote": "node scripts/ai-security-remote.mjs",
    "test": "node --experimental-strip-types --test \"src/engine/__tests__/*.test.ts\" \"src/engine/taskEngine/__tests__/*.test.ts\" \"src/engine/calendarEngine/__tests__/*.test.ts\" \"src/engine/financialEngine/__tests__/*.test.ts\" \"src/engine/taxonomy/__tests__/*.test.ts\" \"src/store/__tests__/*.test.ts\"",
    "test:security:remote": "node scripts/security-smoke.mjs",
    "test:security:local": "node --experimental-strip-types src/services/legacyMigrationCore.test.mjs && node --experimental-strip-types supabase/functions/_shared/webp.test.mjs",
    "expand-dictionaries": "tsx scripts/expand-dictionaries.ts",
    "test:visual-stage4": "node scripts/visual-stage4.test.cjs",
    "test:visual-stage5": "node scripts/visual-stage5.test.cjs",
    "test:visual-stage6": "node scripts/visual-stage6.test.cjs",
    "test:persistence": "node scripts/persistence.test.cjs && node scripts/persistence-auth.test.cjs && node scripts/persistence-sql.test.cjs",
    "test:prelaunch": "node scripts/prelaunch.test.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "1.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@electric-sql/pglite": "^0.5.9",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "ts-morph": "^26.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
